# Browser-visible API origin. This is not a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Native API development. Compose supplies its own container connection string.
DATABASE_URL=postgres://food_store:food_store@localhost:5432/food_store?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_ADDRESS=:8080
